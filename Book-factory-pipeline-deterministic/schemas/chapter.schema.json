{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChapterContent",
  "type": "object",
  "required": ["chapter_id", "title", "tone_profile", "sections"],
  "properties": {
    "chapter_id": { "type": "string" },
    "title": { "type": "string" },
    "tone_profile": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "paragraphs"],
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 20 }
          }
        }
      }
    }
  }
}
