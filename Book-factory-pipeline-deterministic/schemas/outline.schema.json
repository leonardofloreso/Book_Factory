{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Outline",
  "type": "object",
  "required": ["book_id", "title", "tone_profile", "chapters"],
  "properties": {
    "book_id": { "type": "string" },
    "title": { "type": "string" },
    "tone_profile": { "type": "string" },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chapter_id", "title", "objective", "key_points"],
        "properties": {
          "chapter_id": { "type": "string", "pattern": "^ch[0-9]+$" },
          "title": { "type": "string", "minLength": 3 },
          "objective": { "type": "string", "minLength": 3 },
          "key_points": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
